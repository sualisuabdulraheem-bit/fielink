# Copy this file to .env and fill in real values. Never commit .env to GitHub.

# Server
PORT=3000
# Use "development" for local testing (plain HTTP). Render.com sets this to
# "production" automatically for you — production mode requires HTTPS for
# login sessions to work, which Render provides. If you set this to
# "production" locally over plain http://localhost, login will appear to
# succeed but your session cookie won't be sent back — you'll get logged
# out immediately. Keep this as "development" until you deploy.
NODE_ENV=development

# Session security — generate a random string, e.g. run: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=replace_this_with_a_long_random_string

# Admin login
ADMIN_USERNAME=admin
# Generate this hash by running: npm run hash-password
# It will prompt you to type a password and print the hash to paste here.
ADMIN_PASSWORD_HASH=replace_this_with_generated_hash

# Site
SITE_URL=https://www.fielink.com
WHATSAPP_NUMBER=233000000000
